{
  "name": "dsh-hao-import",
  "version": "1.3.0",
  "description": "DSH 启动时自动把 Hao Wallpaper 新下载的壁纸增量导入壁纸引擎（macOS/Windows，幂等，失败不影响启动）。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/run-import.sh",
    "scripts/run-import.ps1",
    "scripts/import_hao.py",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AB-png123/dshplugin.git"
  },
  "homepage": "https://github.com/AB-png123/dshplugin#readme",
  "bugs": {
    "url": "https://github.com/AB-png123/dshplugin/issues"
  },
  "author": "AB-png123",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "hao-wallpaper",
    "windows",
    "startup"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
